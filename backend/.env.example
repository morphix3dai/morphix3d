# Backend Environment Variables
# Copy this to .env and fill in your values

# Server
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://your-app.vercel.app

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/morphix3d

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars

# Razorpay (get from razorpay.com dashboard)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# AI Server URL (local or Colab tunnel)
AI_SERVER_URL=http://localhost:8000

# Optional: Meshy API (paid, higher quality 3D)
# MESHY_API_KEY=your-meshy-key

# Optional: OpenAI (for architecture AI)
# OPENAI_API_KEY=sk-xxxxxxxxxxxx

# Optional: Cloudflare R2 Storage
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=morphix3d-outputs
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
