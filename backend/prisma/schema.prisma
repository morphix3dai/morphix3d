generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USERS
// ==========================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  avatarUrl    String?  @map("avatar_url")
  credits      Int      @default(200)
  plan         Plan     @default(FREE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  generations        Generation[]
  creditTransactions  CreditTransaction[]
  assets             Asset[]
  refreshTokens      RefreshToken[]

  @@map("users")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

// ==========================================
// REFRESH TOKENS
// ==========================================
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ==========================================
// GENERATIONS (AI Jobs)
// ==========================================
model Generation {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  type          GenerationType
  prompt        String?
  inputImageUrl String?          @map("input_image_url")
  status        GenerationStatus @default(PENDING)
  outputUrls    Json?            @map("output_urls")
  creditsUsed   Int              @map("credits_used")
  styleOption   String?          @map("style_option")
  poseOption    String?          @map("pose_option")
  modelType     String?          @map("model_type")
  errorMessage  String?          @map("error_message")
  progress      Int              @default(0)
  createdAt     DateTime         @default(now()) @map("created_at")
  completedAt   DateTime?        @map("completed_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@index([userId])
  @@index([status])
  @@map("generations")
}

enum GenerationType {
  TEXT_TO_3D
  IMAGE_TO_3D
  TEXTURE
  REMESH
  RIG
  MECHANICAL_CAD
  ARCHITECTURE
}

enum GenerationStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// ==========================================
// CREDIT TRANSACTIONS
// ==========================================
model CreditTransaction {
  id                String          @id @default(uuid())
  userId            String          @map("user_id")
  amount            Int
  type              TransactionType
  razorpayPaymentId String?         @map("razorpay_payment_id")
  razorpayOrderId   String?         @map("razorpay_order_id")
  description       String?
  createdAt         DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credit_transactions")
}

enum TransactionType {
  PURCHASE
  USAGE
  BONUS
  REFUND
}

// ==========================================
// ASSETS (Generated 3D Models)
// ==========================================
model Asset {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  generationId String?  @map("generation_id")
  name         String
  fileFormat   String   @map("file_format")
  fileUrl      String   @map("file_url")
  fileSize     Int?     @map("file_size")
  thumbnailUrl String?  @map("thumbnail_url")
  isPublic     Boolean  @default(false) @map("is_public")
  likes        Int      @default(0)
  downloads    Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isPublic])
  @@map("assets")
}
