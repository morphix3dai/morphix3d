# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Device (cuda for GPU, cpu for testing)
DEVICE=cpu

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Model Cache
MODEL_CACHE_DIR=./model_cache
OUTPUT_DIR=./outputs

# Backend callback
BACKEND_URL=http://localhost:4000
BACKEND_API_KEY=

# GPU Settings
HALF_PRECISION=true
MAX_CONCURRENT_JOBS=2
MAX_UPLOAD_SIZE_MB=50
